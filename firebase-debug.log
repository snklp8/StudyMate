[debug] [2026-10-14T14:32:23.187Z] <<< [apiv2][body] POST https://firebaserules.googleapis.com/v1/projects/studymate8/rulesets {"name":"projects/studymate8/rulesets/f3a6b0a7-f243-4b0f-9386-1546d92462b6","source":{"files":[{"content":"rules_version = '2';\r\nservice cloud.firestore {\r\n  match /databases/{database}/documents {\r\n    \r\n    // User profile collection: users/{userId}\r\n    match /users/{userId} {\r\n      // Authenticated users can read their own profile\r\n      allow read: if request.auth != null && request.auth.uid == userId;\r\n      \r\n      // Authenticated users can create their own profile during registration\r\n      // Enforces that the document ID matches the authenticated UID\r\n      allow create: if request.auth != null \r\n                    && request.auth.uid == userId \r\n                    && request.resource.data.uid == userId\r\n                    && request.resource.data.role in ['student', 'teacher'];\r\n      \r\n      // Authenticated users can update their own profile without tampering with uid or role\r\n      allow update: if request.auth != null \r\n                    && request.auth.uid == userId \r\n                    && request.resource.data.uid == resource.data.uid\r\n                    && request.resource.data.role == resource.data.role;\r\n      \r\n      // Disallow user profile deletion from client app\r\n      allow delete: if false;\r\n    }\r\n    \r\n    // Materials collection: materials/{materialId}\r\n    match /materials/{materialId} {\r\n      allow read, delete: if request.auth != null && resource.data.ownerId == request.auth.uid;\r\n      allow create: if request.auth != null && request.resource.data.ownerId == request.auth.uid;\r\n      allow update: if request.auth != null \r\n                    && resource.data.ownerId == request.auth.uid \r\n                    && request.resource.data.ownerId == request.auth.uid;\r\n    }\r\n\r\n    // Summaries collection: summaries/{materialId}\r\n    match /summaries/{materialId} {\r\n      allow read: if request.auth != null && resource.data.ownerId == request.auth.uid;\r\n      allow write: if request.auth != null && request.resource.data.ownerId == request.auth.uid;\r\n    }\r\n\r\n    // Default fallback: deny all other paths\r\n    match /{document=**} {\r\n      allow read, write: if false;\r\n    }\r\n  }\r\n}\r\n","name":"firestore.rules"}]},"createTime":"2026-10-14T14:32:22.959471Z","metadata":{"services":["cloud.firestore"]}}
