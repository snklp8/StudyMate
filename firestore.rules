rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // User profile collection: users/{userId}
    match /users/{userId} {
      // Authenticated users can read their own profile
      allow read: if request.auth != null && request.auth.uid == userId;
      
      // Authenticated users can create their own profile during registration
      // Enforces that the document ID matches the authenticated UID
      allow create: if request.auth != null 
                    && request.auth.uid == userId 
                    && request.resource.data.uid == userId
                    && request.resource.data.role in ['student', 'teacher'];
      
      // Authenticated users can update their own profile without tampering with uid or role
      allow update: if request.auth != null 
                    && request.auth.uid == userId 
                    && request.resource.data.uid == resource.data.uid
                    && request.resource.data.role == resource.data.role;
      
      // Disallow user profile deletion from client app
      allow delete: if false;
    }
    
    // Materials collection: materials/{materialId}
    match /materials/{materialId} {
      allow read, delete: if request.auth != null && resource.data.ownerId == request.auth.uid;
      allow create: if request.auth != null && request.resource.data.ownerId == request.auth.uid;
      allow update: if request.auth != null 
                    && resource.data.ownerId == request.auth.uid 
                    && request.resource.data.ownerId == request.auth.uid;
    }

    // Summaries collection: summaries/{materialId}
    match /summaries/{materialId} {
      allow read: if request.auth != null && resource.data.ownerId == request.auth.uid;
      allow write: if request.auth != null && request.resource.data.ownerId == request.auth.uid;
    }

    // Default fallback: deny all other paths
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
